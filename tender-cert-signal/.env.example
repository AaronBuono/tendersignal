# Copy to .env and fill in. All values are optional; sane defaults apply.

# Path to the SQLite database file. Default: tendersignal.db in the working directory.
DB_PATH=tendersignal.db

# Slack (or Slack-compatible, e.g. Mattermost) incoming webhook URL for the lead digest.
# If unset, the digest is printed to stdout instead — useful for testing before you wire up Slack.
SLACK_WEBHOOK_URL=

# On first run (no checkpoint yet), how many days back to backfill from AusTender.
LOOKBACK_DAYS=3

# Minimum fuzzy-match score (0-100) against a JAS-ANZ register entry to count as "certified".
# Lower = more false "certified" matches; higher = more false "no cert found" leads.
MATCH_THRESHOLD=87

# Seconds to wait between JAS-ANZ lookups (politeness / rate limiting).
JASANZ_RATE_LIMIT_SECONDS=1.0

# Days to wait before re-checking a flagged lead in case they've since been certified.
RECHECK_DAYS=30

# Skip contracts below this AUD value entirely (0 = no filter).
MIN_CONTRACT_VALUE=0

# Optional. Enriches each supplier's canonical legal name, entity type (company vs individual/
# sole trader), and trading names via the ABN Lookup API. Free, but requires registering for a
# GUID (~2 minutes, just an email address) at https://abr.business.gov.au/Tools/WebServices —
# enrichment is skipped entirely if this is left blank.
ABN_LOOKUP_GUID=

# Skip contracts above this AUD value as "too big for Kaiso's target market" (0 = no cap).
MAX_CONTRACT_VALUE=500000

# Google Sheet sync (see sheets/SETUP.md). Leave blank to just get leads.csv.
SHEET_WEBHOOK_URL=
SHEET_WEBHOOK_TOKEN=

# Optional: the normal (browser) link to your lead sheet. If set, the launcher opens it when done
# instead of opening leads.csv.
SHEET_VIEW_URL=
